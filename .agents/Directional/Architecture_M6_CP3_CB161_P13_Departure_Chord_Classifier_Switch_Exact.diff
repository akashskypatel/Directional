diff --git a/tests/FieldAlignedCurveNetworkTests.cpp b/tests/FieldAlignedCurveNetworkTests.cpp
index 6b7420af5b30dd8179cbdf6aaee213413727b2c1..3189718838fd69b144abb3e16ef231e458100857 100644
