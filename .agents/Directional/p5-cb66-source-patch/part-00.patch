+std::uint64_t rollback_identity_hash(
+    const std::vector<std::uint64_t> &identity) {
+  std::uint64_t hash = 1469598103934665603ULL;
+  for (const std::uint64_t word : identity) {
+    hash ^= word;
+    hash *= 1099511628211ULL;
+  }
+  return hash;
+}
