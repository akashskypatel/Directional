+// Paths from a class root, searched once per root and reused for every target.
+// Equal to quotient_forest_path(root, target, adjacency) for each target.
+class QuotientForestRootedPaths {
+public:
+  explicit QuotientForestRootedPaths(const QuotientForestAdjacency &adjacency)
+      : adjacency_(adjacency) {}
+
+  std::optional<std::vector<QuotientForestTraversalEdge>>
+  path(const authority::OccurrenceId root, const authority::OccurrenceId target) {
+    auto found = parentsByRoot_.find(root);
+    if (found == parentsByRoot_.end()) {
+      found = parentsByRoot_
+                  .emplace(root, quotient_forest_parents(root, std::nullopt,
+                                                         adjacency_))
+                  .first;
+    }
+    return quotient_forest_path_from_parents(root, target, found->second);
+  }
