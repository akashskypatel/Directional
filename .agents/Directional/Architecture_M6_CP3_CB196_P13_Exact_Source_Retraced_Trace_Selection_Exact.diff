diff --git a/include/directional/authority/ExactSourcePath.h b/include/directional/authority/ExactSourcePath.h
index a968576ef..fbae34c64 100644
--- a/include/directional/authority/ExactSourcePath.h
+++ b/include/directional/authority/ExactSourcePath.h
@@ -10,6 +10,8 @@
 
 #include <algorithm>
 #include <array>
+#include <compare>
+#include <cstddef>
 #include <map>
 #include <optional>
 #include <utility>
@@ -308,6 +310,39 @@ exact_source_paths_retrace_along_edges(const ExactSourcePath &a,
   return coveredByA.has_value() && coveredByA == coverage(b);
 }
 
+/** A trace that runs back over an earlier trace along source edges, and the
+ * earlier trace it repeats. Both are positions in the list given to
+ * `exact_source_retraced_traces`, and `kept < removed`. */
+struct ExactSourceRetracedTrace {
+  std::size_t kept = 0U;
+  std::size_t removed = 0U;
+
+  auto operator<=>(const ExactSourceRetracedTrace &) const = default;
+};
+
+/** The traces that repeat an earlier trace of `paths` backwards along source
+ * edges (`exact_source_paths_retrace_along_edges`), in increasing order of
+ * `removed`. Each is paired with the first earlier trace it retraces that is
+ * not itself removed, so a kept trace is never removed. An empty path
+ * retraces nothing. */
+[[nodiscard]] inline std::vector<ExactSourceRetracedTrace>
+exact_source_retraced_traces(const std::vector<ExactSourcePath> &paths) {
+  std::vector<ExactSourceRetracedTrace> retraced;
+  std::vector<bool> removed(paths.size(), false);
+  for (std::size_t later = 1U; later < paths.size(); ++later) {
+    for (std::size_t earlier = 0U; earlier < later; ++earlier) {
+      if (removed[earlier] ||
+          !exact_source_paths_retrace_along_edges(paths[earlier], paths[later])) {
+        continue;
+      }
+      removed[later] = true;
+      retraced.push_back(ExactSourceRetracedTrace{earlier, later});
+      break;
+    }
+  }
+  return retraced;
+}
+
 } // namespace directional::authority
 
 #endif // DIRECTIONAL_AUTHORITY_EXACT_SOURCE_PATH_H
diff --git a/tests/FieldAlignedCurveNetworkTests.cpp b/tests/FieldAlignedCurveNetworkTests.cpp
index bfc99a223..92fe1c385 100644
--- a/tests/FieldAlignedCurveNetworkTests.cpp
+++ b/tests/FieldAlignedCurveNetworkTests.cpp
@@ -23236,3 +23236,50 @@ TEST(ExactSourcePathRetrace, SameWayOtherEdgeOrFaceCrossingPathsDoNotRetrace) {
       crossing, {edge_piece(1, 2, at_vertex(2), at_vertex(1)),
                  edge_piece(0, 1, at_vertex(1), at_vertex(0))}));
 }
+
+TEST(ExactSourceRetracedTraces, EachLaterRetraceIsRemovedInFavourOfItsEarliestKeptTrace) {
+  using namespace arc_face_visit_test;
+  using directional::authority::exact_source_retraced_traces;
+  using directional::authority::ExactSourceRetracedTrace;
+  const auto lower = topology_face(0, 1, 2, 5U);
+  const auto upper = topology_face(1, 3, 2, 5U);
+  // Two saddle connections, 0 -> 1 -> 2 and 2 -> 3, each traced from both
+  // ends on different carriers, interleaved with a trace across [0,1,2].
+  const ExactSourcePath chainForward{
+      face_piece(lower, at_vertex(0), at_vertex(1)),
+      edge_piece(1, 2, at_vertex(1), at_vertex(2))};
+  const ExactSourcePath chainBackward{
+      face_piece(upper, at_vertex(2), at_vertex(1)),
+      edge_piece(0, 1, at_vertex(1), at_vertex(0))};
+  const ExactSourcePath crossing{
+      face_piece(lower, at_vertex(0), on_edge(1, 2, 1, 2))};
+  const ExactSourcePath spurForward{
+      face_piece(upper, at_vertex(2), at_vertex(3))};
+  const ExactSourcePath spurBackward{
+      edge_piece(2, 3, at_vertex(3), at_vertex(2))};
+  const std::vector<ExactSourceRetracedTrace> expected{{0U, 3U}, {2U, 4U}};
+  EXPECT_EQ(expected,
+            exact_source_retraced_traces({chainForward, crossing, spurBackward,
+                                          chainBackward, spurForward}));
+  // The earlier trace of each pair is kept, whichever direction it runs.
+  const std::vector<ExactSourceRetracedTrace> swapped{{0U, 1U}};
+  EXPECT_EQ(swapped,
+            exact_source_retraced_traces({chainBackward, chainForward}));
+}
+
+TEST(ExactSourceRetracedTraces, SameWayOtherEdgeAndEmptyPathsAreKept) {
+  using namespace arc_face_visit_test;
+  using directional::authority::exact_source_retraced_traces;
+  const auto lower = topology_face(0, 1, 2, 5U);
+  const ExactSourcePath chain{edge_piece(0, 1, at_vertex(0), at_vertex(1)),
+                              edge_piece(1, 2, at_vertex(1), at_vertex(2))};
+  // A same-way copy, a path back from 2 to 0 along the other edge (0,2), and
+  // an empty path are no retrace.
+  EXPECT_TRUE(exact_source_retraced_traces(
+                  {chain, chain,
+                   {face_piece(lower, at_vertex(2), at_vertex(0))},
+                   ExactSourcePath{}})
+                  .empty());
+  EXPECT_TRUE(exact_source_retraced_traces({}).empty());
+  EXPECT_TRUE(exact_source_retraced_traces({chain}).empty());
+}
