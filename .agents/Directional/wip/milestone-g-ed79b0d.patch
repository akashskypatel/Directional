--- a/src/geometry/FlowRepStrands.cpp
+++ b/src/geometry/FlowRepStrands.cpp
@@ -2460,44 +2460,23 @@ FlowRepEndpointCompletionResult complete_flow_rep_endpoints(
   std::vector<std::vector<int>> activeArcsByFace(
       static_cast<std::size_t>(faces.rows()));
   std::map<std::uint64_t, int> endpointDegree;
-  std::vector<unsigned char> seen(result.arcs.size(), 0U);
-  std::vector<int> filteredRetainedArcIds;
-  filteredRetainedArcIds.reserve(result.retainedArcIds.size());
-  const auto removable_degenerate_support = [&](const FlowRepArc &arc) {
-    if (!arc.layoutSupport || arc.singularitySupport || arc.mandatoryRail ||
-        arc.boundaryRail || arc.hardFeatureRail) {
-      return false;
-    }
-    const double length = flow_rep_detail::arc_length(arc);
-    return std::isfinite(length) && length <= options.intersectionTolerance;
-  };
+  std::vector<unsigned char> retained(result.arcs.size(), 0U);
   for (const int arcId : result.retainedArcIds) {
     if (arcId < 0 || arcId >= static_cast<int>(result.arcs.size()) ||
         result.arcs[static_cast<std::size_t>(arcId)].id != arcId) {
       result.failure = "InvalidRetainedArcIdentity";
       return result;
     }
-    if (seen[static_cast<std::size_t>(arcId)] != 0U) {
+    if (retained[static_cast<std::size_t>(arcId)] != 0U) {
       result.failure = "DuplicateRetainedArc";
       return result;
     }
-    seen[static_cast<std::size_t>(arcId)] = 1U;
+    retained[static_cast<std::size_t>(arcId)] = 1U;
     const FlowRepArc &arc = result.arcs[static_cast<std::size_t>(arcId)];
     if (!flow_rep_detail::arc_has_complete_provenance(arc)) {
       result.failure = "IncompleteRetainedArcProvenance";
       return result;
     }
-    // Endpoint completion rejects generated segments at or below this same
-    // tolerance.  Optional retained tails below that resolution cannot be
-    // represented robustly in the arrangement: their endpoints collapse to
-    // one intrinsic node and create a dangling bridge.  Remove only optional
-    // layout support. Required singular branches and authoritative rails stay
-    // fail-closed and are never sanitized away.
-    if (removable_degenerate_support(arc)) {
-      ++result.removedDegenerateArcs;
-      continue;
-    }
-    filteredRetainedArcIds.push_back(arcId);
     if (arc.sourceFace >= 0 && arc.sourceFace < faces.rows()) {
       activeArcsByFace[static_cast<std::size_t>(arc.sourceFace)].push_back(
           arcId);
@@ -2505,8 +2484,6 @@ FlowRepEndpointCompletionResult complete_flow_rep_endpoints(
     ++endpointDegree[flow_rep_detail::embedded_endpoint_key(arc, true)];
     ++endpointDegree[flow_rep_detail::embedded_endpoint_key(arc, false)];
   }
-  result.retainedArcIds = std::move(filteredRetainedArcIds);
