+TEST(FieldAlignedCarrierOccupancy,
+     TerminalCarrierLocusIsInertByDefaultAndExactWhenPresent) {
+  using directional::geometry::FieldAlignedTerminalContact;
+  const auto face = topology_face(0, 1, 2);
+  const auto carrier = topology_edge(0, 2);
+  const auto contactPoint = boundary_point(carrier, 1, 3);
+  const FieldAlignedTerminalContact legacy{
+      face, {exact_ratio(2, 3), exact_ratio(0, 1), exact_ratio(1, 3)},
+      directional::authority::TraceId::from_index(0U, 2U).value(), 0U};
+  ASSERT_FALSE(legacy.carrierLocus.has_value());
+  auto withLocus = legacy;
+  withLocus.carrierLocus = contactPoint;
+  ASSERT_TRUE(withLocus.carrierLocus.has_value());
+  EXPECT_EQ(*withLocus.carrierLocus, contactPoint);
+  EXPECT_NE(withLocus, legacy);
+  auto otherLocus = withLocus;
+  otherLocus.carrierLocus = boundary_point(carrier, 2, 3);
+  EXPECT_NE(otherLocus, withLocus);
+  EXPECT_EQ(legacy.struckSegmentIndex, withLocus.struckSegmentIndex);
+  EXPECT_EQ(legacy.barycentric, withLocus.barycentric);
+}
