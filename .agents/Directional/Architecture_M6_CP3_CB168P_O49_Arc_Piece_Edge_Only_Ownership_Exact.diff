+TEST(FieldAlignedCarrierOccupancy,
+     TraceArcSegmentPiecesReadTheArcsOwnPartOfASlide) {
+  namespace authority = directional::authority;
+  using directional::authority::FieldBranch;
+  using directional::authority::TopologyRegionId;
+  using directional::authority::TraceId;
+  using directional::geometry::FieldAlignedCandidateTrace;
+  using directional::geometry::GlobalTopologyArc;
+  using directional::geometry::GlobalTopologyArcKind;
+  using Counts = std::vector<std::size_t>;
+  using Path = authority::ExactSourcePath;
+  using Piece = authority::ExactSourceSupportPiece;
+  using Position = embedded::TraceCutPosition;
+  // The trace enters [0,1,4] at vertex 4, slides along (0,1) from 1/4 to
+  // vertex 1, then crosses [1,2,4] to (2,4) at 1/2. A cut halfway along the
+  // slide, at 5/8 of (0,1), splits it into two arcs.
+  const auto first = topology_face(0, 1, 4, 5U);
+  const auto second = topology_face(1, 2, 4, 5U);
+  const auto incoming = topology_edge(0, 4, 5U);
+  const auto carrier = topology_edge(0, 1, 5U);
+  const auto next = topology_edge(1, 4, 5U);
+  const auto outgoing = topology_edge(2, 4, 5U);
+  FieldAlignedCandidateTrace trace(
+      TraceId::from_index(0U, 2U).value(),
+      SingularityPortId::from_index(0, 1).value(),
+      FieldSingularityId::from_index(0, 1).value(),
+      SourceVertexId::from_index(4, 5).value(),
+      SourceComponentId::from_index(0, 1).value(),
+      TopologyRegionId::from_index(0, 1).value());
+  const auto branch = FieldBranch::from_integer(0);
+  trace.segments.emplace_back(first, branch, boundary_point(incoming, 1, 1),
+                              incoming, carrier, std::nullopt);
+  trace.segments[0].edgeTransitEntry = boundary_point(carrier, 1, 4);
+  trace.segments[0].edgeTransitExit = boundary_point(carrier, 1, 1);
+  trace.segments.emplace_back(second, branch, boundary_point(next, 0, 1), next,
+                              outgoing, std::nullopt);
+  trace.terminalPoint = boundary_point(outgoing, 1, 2);
+  const Position start{0U, std::nullopt};
+  const Position end{2U, std::nullopt};
+  const Position slideCut{0U, exact_ratio(1, 2)};
+
+  // Arcs as the graph would publish them from the producer's real pieces.
+  const auto arc_between = [&](const Position &from, const Position &to) {
+    GlobalTopologyArc arc{
+        authority::NetworkArcId::from_index(0U, 1U).value(),
+        GlobalTopologyArcKind::Trace,
+        authority::NetworkNodeId::from_index(0U, 2U).value(),
+        authority::NetworkNodeId::from_index(1U, 2U).value(),
+        std::nullopt, trace.id, std::nullopt, 0U, 0U, {}, {}, {}};
+    const auto [begin, onePastLast] = embedded::trace_cut_segment_range(from, to);
+    arc.firstSegment = begin;
+    arc.onePastLastSegment = onePastLast;
+    for (std::size_t segment = begin; segment < onePastLast; ++segment) {
+      arc.sourceFaces.push_back(trace.segments[segment].sourceFace);
+    }
+    const auto path = embedded::exact_trace_piece_path_between(
+        trace, from, to, &arc.sourcePieceCounts);
+    EXPECT_TRUE(path.has_value());
+    if (path.has_value()) arc.sourcePath = *path;
+    return arc;
+  };
+  const GlobalTopologyArc toCut = arc_between(start, slideCut);
+  const GlobalTopologyArc fromCut = arc_between(slideCut, end);
+  ASSERT_EQ((Counts{2U}), toCut.sourcePieceCounts);
+  ASSERT_EQ((Counts{1U, 1U}), fromCut.sourcePieceCounts);
+  ASSERT_FALSE(embedded::source_piece_binding_failure(
+      fromCut.sourceFaces, fromCut.sourcePieceCounts, fromCut.sourcePath));
+
+  // The arc from the cut owns only the slide's edge piece after the cut,
+  // although the whole segment is a face piece and then the slide.
+  const authority::ExactSourcePoint v1{SourceVertexId::from_index(1, 5).value()};
+  const authority::ExactSourcePoint cut{
+      authority::ExactSourceEdgePoint{carrier, exact_ratio(5, 8)}};
+  const Piece afterCut{authority::SourceEdgeSupport{carrier}, cut, v1};
+  const auto whole = embedded::exact_trace_segment_pieces(trace, 0U);
+  ASSERT_TRUE(whole.has_value());
+  EXPECT_EQ(2U, whole->size());
+  EXPECT_EQ((Path{afterCut}), embedded::trace_arc_segment_pieces(fromCut, 0U));
+  ASSERT_TRUE(std::holds_alternative<authority::SourceFaceInteriorSupport>(
+      fromCut.sourcePath.back().carrier));
+  EXPECT_EQ((Path{fromCut.sourcePath.back()}),
+            embedded::trace_arc_segment_pieces(fromCut, 1U));
+  // The arc up to the cut owns the face piece and the slide up to the cut.
+  ASSERT_EQ(2U, toCut.sourcePath.size());
+  EXPECT_EQ(toCut.sourcePath, embedded::trace_arc_segment_pieces(toCut, 0U));
+
+  // Today's graph publishes one face chord per segment, so no arc has an
+  // edge-only part before the producer publishes real pieces.
+  GlobalTopologyArc chord = fromCut;
+  const auto chordPath =
+      embedded::exact_trace_path_between(trace, slideCut, end);
+  ASSERT_TRUE(chordPath.has_value());
+  chord.sourcePath = *chordPath;
+  chord.sourcePieceCounts.assign(chord.sourceFaces.size(), 1U);
+  const auto chordPieces = embedded::trace_arc_segment_pieces(chord, 0U);
+  ASSERT_TRUE(chordPieces.has_value());
+  ASSERT_EQ(1U, chordPieces->size());
+  EXPECT_TRUE(std::holds_alternative<authority::SourceFaceInteriorSupport>(
+      chordPieces->front().carrier));
+
+  // Empty outside the arc, on another arc kind, or when the counts do not
+  // partition the path.
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(toCut, 1U));
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(fromCut, 2U));
+  GlobalTopologyArc mandatory = fromCut;
+  mandatory.kind = GlobalTopologyArcKind::Mandatory;
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(mandatory, 0U));
+  GlobalTopologyArc overCounted = fromCut;
+  overCounted.sourcePieceCounts = {2U, 1U};
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(overCounted, 0U));
+  GlobalTopologyArc missingCount = fromCut;
+  missingCount.sourcePieceCounts = {2U};
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(missingCount, 0U));
+  GlobalTopologyArc emptySegment = fromCut;
+  emptySegment.sourcePieceCounts = {0U, 2U};
+  EXPECT_FALSE(embedded::trace_arc_segment_pieces(emptySegment, 0U));
+}
