+std::optional<authority::ExactSourcePath> trace_arc_segment_pieces(
+    const GlobalTopologyArc &arc, const std::size_t segment) {
+  if (arc.kind != GlobalTopologyArcKind::Trace ||
+      segment < arc.firstSegment || segment >= arc.onePastLastSegment ||
+      arc.sourcePieceCounts.size() !=
+          arc.onePastLastSegment - arc.firstSegment) {
+    return std::nullopt;
+  }
+  const std::size_t local = segment - arc.firstSegment;
+  std::size_t first = 0U;
+  std::size_t total = 0U;
+  for (std::size_t index = 0U; index < arc.sourcePieceCounts.size(); ++index) {
+    if (index == local) first = total;
+    total += arc.sourcePieceCounts[index];
+  }
+  const std::size_t count = arc.sourcePieceCounts[local];
+  if (count == 0U || total != arc.sourcePath.size()) return std::nullopt;
+  const auto begin =
+      arc.sourcePath.begin() + static_cast<std::ptrdiff_t>(first);
+  return authority::ExactSourcePath(
+      begin, begin + static_cast<std::ptrdiff_t>(count));
+}
