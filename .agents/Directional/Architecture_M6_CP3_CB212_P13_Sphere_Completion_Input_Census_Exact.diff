+                  << " hardFeature=" << flag(edge.hardFeature)
+                  << " sourceArc=" << edge.sourceArc << " curve=" << edge.curveId << '\n';
+      }
+    } else {
+      std::cout << "SphereAuditedInputCell unavailable\n";
+    }
+  }
