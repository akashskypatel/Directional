+std::optional<std::size_t> exact_count_to_size(const EInt &value) {
+  if (value <= EInt(0)) return std::nullopt;
+  const std::string text = value.to_string();
+  std::size_t converted = 0U;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), converted);
+  if (parsed.ec != std::errc{} || parsed.ptr != text.data() + text.size()) {
+    return std::nullopt;
+  }
+  return converted;
+}
+
+// D4/D5 (RA-228): one Mandatory arc read on its source edge from the plan:
+// its bound span and the span breakpoints that lie on it. Every producer that
+// reads a source edge from A3 reads it through this.
+struct EdgeArcSchedule {
+  const GlobalTopologyArc *arc = nullptr;
+  const BaselineConformityArcBinding *binding = nullptr;
+  const ConformityScheduleEntry *schedule = nullptr;
+  std::size_t count = 0U;
+  SourceEdgeArcBreakpoints located;
+};
+
+// Each span's breakpoints, ordinals 0..count, located once per producer call.
+using SpanBreakpointLocations =
+    std::map<ConformitySpanId, std::vector<ConformityBreakpointLocation>>;
+
+// Nothing unless `arc` is one piece of `edge` on `mandatoryEdge` and its span
+// locates every ordinal.
+std::optional<EdgeArcSchedule> edge_arc_schedule(
+    const GlobalConformityBaselinePlan &baseline, const GlobalTopologyArc &arc,
+    const authority::NetworkEdgeId mandatoryEdge,
+    const authority::SourceEdgeTopologyKey &edge,
+    SpanBreakpointLocations &spanBreakpoints) {
+  if (arc.kind != GlobalTopologyArcKind::Mandatory ||
+      !arc.mandatoryEdge.has_value() || *arc.mandatoryEdge != mandatoryEdge ||
+      arc.sourcePath.size() != 1U) {
+    return std::nullopt;
+  }
+  const auto *carrier =
+      std::get_if<authority::SourceEdgeSupport>(&arc.sourcePath.front().carrier);
+  const auto first = exact_edge_parameter(arc.sourcePath.front().first, edge);
+  const auto second = exact_edge_parameter(arc.sourcePath.front().second, edge);
+  const BoundArcSchedule bound = bound_arc_schedule(baseline, arc);
+  const ConformityScheduleEntry *schedule = bound.schedule;
+  const auto count = schedule == nullptr ? std::optional<std::size_t>{}
+                                         : exact_count_to_size(schedule->count);
+  if (carrier == nullptr || carrier->edge != edge || !first || !second ||
+      !(*first < *second) || schedule == nullptr || !count || *count == 0U ||
+      *count > static_cast<std::size_t>(std::numeric_limits<int>::max())) {
+    return std::nullopt;
+  }
+  const BaselineConformityArcBinding &binding = *bound.binding;
+  const ConformitySpanId span = binding.span;
+  auto located = spanBreakpoints.find(span);
+  if (located == spanBreakpoints.end()) {
+    std::vector<ConformityBreakpointLocation> locations;
+    locations.reserve(*count + 1U);
+    for (std::size_t ordinal = 0U; ordinal <= *count; ++ordinal) {
+      auto location = baseline.breakpoint_location(
+          span, EInt(static_cast<long long>(ordinal)));
+      if (!location || location->localDenominator == EInt(0)) {
+        return std::nullopt;
+      }
+      locations.push_back(std::move(*location));
+    }
+    located = spanBreakpoints.emplace(span, std::move(locations)).first;
+  }
+  const std::vector<ConformityBreakpointLocation> &locations = located->second;
+  // A Mandatory arc is one piece of its span's support.
+  const std::size_t piece = binding.firstSupportPiece;
+  const auto before_piece = [](const ConformityBreakpointLocation &location,
+                               const std::size_t value) {
+    return location.supportPieceIndex < value;
+  };
+  const std::size_t begin = static_cast<std::size_t>(
+      std::lower_bound(locations.begin(), locations.end(), piece,
+                       before_piece) -
+      locations.begin());
+  std::size_t end = static_cast<std::size_t>(
+      std::lower_bound(locations.begin(), locations.end(), piece + 1U,
+                       before_piece) -
+      locations.begin());
+  // A breakpoint on the piece's far end is located at the start of the next
+  // piece.
+  if (end < locations.size() &&
+      locations[end].supportPieceIndex == piece + 1U &&
+      locations[end].localNumerator == EInt(0)) {
+    ++end;
+  }
+  const bool chainForward =
+      binding.orientation == authority::Orientation::Forward;
+  const authority::FieldExactRational &pieceStart =
+      chainForward ? *first : *second;
+  const authority::FieldExactRational &pieceEnd =
+      chainForward ? *second : *first;
+  const auto one = authority::FieldExactRational::from_integer(1);
+  EdgeArcSchedule read{&arc, bound.binding, schedule, *count,
+                       SourceEdgeArcBreakpoints{span.network_arc(), *first,
+                                                *second, {}}};
+  read.located.breakpoints.reserve(end - begin);
+  for (std::size_t ordinal = begin; ordinal < end; ++ordinal) {
+    const ConformityBreakpointLocation &location = locations[ordinal];
+    const auto local =
+        location.supportPieceIndex == piece
+            ? authority::FieldExactRational::from_exact_fraction(
+                  location.localNumerator, location.localDenominator)
+            : std::optional<authority::FieldExactRational>{one};
+    if (!local) return std::nullopt;
+    read.located.breakpoints.push_back(
+        {ordinal, pieceStart + *local * (pieceEnd - pieceStart)});
+  }
+  return read;
+}
+
+// Puts the arcs read on one source edge in edge order; false unless at most
+// two arcs tile the edge from 0 to 1.
+bool order_edge_arc_schedules(std::vector<EdgeArcSchedule> &arcs) {
+  const auto zero = authority::FieldExactRational::from_integer(0);
+  const auto one = authority::FieldExactRational::from_integer(1);
+  std::sort(arcs.begin(), arcs.end(),
+            [](const EdgeArcSchedule &a, const EdgeArcSchedule &b) {
+              if (a.located.first != b.located.first) {
+                return a.located.first < b.located.first;
+              }
+              return a.located.second < b.located.second;
+            });
+  if (arcs.empty() || arcs.size() > 2U || arcs.front().located.first != zero ||
+      arcs.back().located.second != one) {
+    return false;
+  }
+  for (std::size_t index = 1U; index < arcs.size(); ++index) {
+    if (arcs[index - 1U].located.second != arcs[index].located.first) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Every Mandatory arc on `mandatoryEdge`, read on `edge`, in edge order.
+std::optional<std::vector<EdgeArcSchedule>> mandatory_edge_arc_schedules(
+    const GlobalTopologyPlan &topology,
+    const GlobalConformityBaselinePlan &baseline,
+    const authority::NetworkEdgeId mandatoryEdge,
+    const authority::SourceEdgeTopologyKey &edge,
+    SpanBreakpointLocations &spanBreakpoints) {
+  std::vector<EdgeArcSchedule> arcs;
+  for (const GlobalTopologyArc &arc : topology.arcs()) {
+    if (arc.kind != GlobalTopologyArcKind::Mandatory ||
+        !arc.mandatoryEdge.has_value() || *arc.mandatoryEdge != mandatoryEdge) {
+      continue;
+    }
+    auto read =
+        edge_arc_schedule(baseline, arc, mandatoryEdge, edge, spanBreakpoints);
+    if (!read) return std::nullopt;
+    arcs.push_back(std::move(*read));
+  }
+  if (!order_edge_arc_schedules(arcs)) return std::nullopt;
+  return arcs;
+}
+
 } // namespace
 
+std::optional<std::vector<SourceEdgeArcBreakpoints>> source_edge_arc_breakpoints(
+    const GlobalTopologyPlan &topology,
+    const GlobalConformityBaselinePlan &baseline,
+    const authority::NetworkEdgeId mandatoryEdge,
+    const authority::SourceEdgeTopologyKey &edge) {
+  SpanBreakpointLocations spanBreakpoints;
+  auto arcs = mandatory_edge_arc_schedules(topology, baseline, mandatoryEdge,
+                                           edge, spanBreakpoints);
+  if (!arcs) return std::nullopt;
+  std::vector<SourceEdgeArcBreakpoints> located;
+  located.reserve(arcs->size());
+  for (EdgeArcSchedule &arc : *arcs) located.push_back(std::move(arc.located));
+  return located;
+}
