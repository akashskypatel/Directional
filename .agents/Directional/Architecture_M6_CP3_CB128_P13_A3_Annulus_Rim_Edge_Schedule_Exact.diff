+std::optional<std::vector<AnnulusRimInterval>> read_annulus_rim_edge(
+    const std::vector<SourceEdgeArcBreakpoints> &arcs, const bool forward) {
+  using Rational = authority::FieldExactRational;
+  const Rational zero = Rational::from_integer(0);
+  const Rational one = Rational::from_integer(1);
+  struct WalkBreakpoint {
+    Rational parameter;
+    std::size_t ordinal = 0U;
+  };
+  std::vector<Rational> points;
+  std::vector<AnnulusRimInterval> intervals;
+  for (std::size_t index = 0U; index < arcs.size(); ++index) {
+    const SourceEdgeArcBreakpoints &arc =
+        arcs[forward ? index : arcs.size() - 1U - index];
+    std::vector<WalkBreakpoint> walk;
+    walk.reserve(arc.breakpoints.size());
+    for (const SourceEdgeSpanBreakpoint &breakpoint : arc.breakpoints) {
+      walk.push_back({forward ? breakpoint.parameter : one - breakpoint.parameter,
+                      breakpoint.ordinal});
+    }
+    std::sort(walk.begin(), walk.end(),
+              [](const WalkBreakpoint &a, const WalkBreakpoint &b) {
+                return a.parameter < b.parameter;
+              });
+    const Rational start = forward ? arc.first : one - arc.second;
+    const Rational end = forward ? arc.second : one - arc.first;
+    if (walk.size() < 2U || walk.front().parameter != start ||
+        walk.back().parameter != end ||
+        (points.empty() ? start != zero : points.back() != start)) {
+      return std::nullopt;
+    }
+    if (points.empty()) points.push_back(start);
+    for (std::size_t step = 1U; step < walk.size(); ++step) {
+      const WalkBreakpoint &from = walk[step - 1U];
+      const WalkBreakpoint &to = walk[step];
+      if (!(from.parameter < to.parameter) ||
+          (to.ordinal != from.ordinal + 1U && from.ordinal != to.ordinal + 1U)) {
+        return std::nullopt;
+      }
+      points.push_back(to.parameter);
+      intervals.push_back({arc.span, from.ordinal, to.ordinal});
+    }
+  }
+  if (intervals.empty() || points.back() != one) return std::nullopt;
+  const Rational parts =
+      Rational::from_integer(static_cast<std::int64_t>(intervals.size()));
+  for (std::size_t k = 0U; k < points.size(); ++k) {
+    if (points[k] * parts != Rational::from_integer(static_cast<std::int64_t>(k))) {
+      return std::nullopt;
+    }
+  }
+  return intervals;
+}
