+// P13-e (RA-239): the vertex-star owner is elected from geometry alone
+// (Amendment 22). When the owner's own field has a negative weight on a corner
+// other than the vertex, the next step enters at the vertex with exit time
+// zero (BranchContinuationDegenerateEntry). Print the owner and every sector's
+// field so the star can be read against the source mesh.
+void report_field_vertex_transit_without_outflow(
+    const authority::FieldBranchTopology &topology,
+    const FieldAlignedCandidateTrace &trace,
+    const authority::SourceVertexId vertex,
+    const FieldVertexArrivalMode arrivalMode,
+    const authority::SourceFaceTopologyKey &arrivalFace,
+    const authority::FieldBranch arrivalBranch,
+    const authority::SourceEdgeTopologyKey &carrier,
+    const FieldVertexTransitDecision &transit) {
+  const auto pairing_of = [&](const authority::SourceFaceTopologyKey &face,
+                              const authority::FieldBranch branch)
+      -> const authority::FieldBranchBoundaryPairing * {
+    const authority::FieldFaceBranchFrame *frame = topology.find_frame(face);
+    return frame == nullptr ? nullptr
+                            : field_aligned_branch_pairing(*frame, branch);
+  };
+  const auto *owner = pairing_of(transit.nextFace, transit.nextBranch);
+  if (owner == nullptr) return;
+  const auto zero = authority::FieldExactRational::from_integer(0);
+  const auto &ownerVertices = transit.nextFace.vertices();
+  bool leaves = true;
+  for (std::size_t index = 0U; index < ownerVertices.size(); ++index) {
+    if (ownerVertices[index] != vertex && owner->direction[index] < zero) {
+      leaves = false;
+    }
+  }
+  if (leaves) return;
+
+  const auto face_text = [](const authority::SourceFaceTopologyKey &face) {
+    const auto &vertices = face.vertices();
+    std::ostringstream out;
+    out << '(' << vertices[0].index() << ',' << vertices[1].index() << ','
+        << vertices[2].index() << ')';
+    return out.str();
+  };
+  const auto direction_text =
+      [](const authority::SourceFaceTopologyKey &face,
+         const authority::FieldBranchBoundaryPairing *pairing) {
+        std::ostringstream out;
+        if (pairing == nullptr || !pairing->direction.is_barycentric()) {
+          out << " direction=none";
+          return out.str();
+        }
+        const auto &vertices = face.vertices();
+        for (std::size_t index = 0U; index < vertices.size(); ++index) {
+          out << " w" << vertices[index].index() << '='
+              << static_cast<double>(pairing->direction[index].to_double());
+        }
+        return out.str();
+      };
+  const auto &audit = transit.vertexStarTransit;
+  std::clog << "FieldAlignedCurveNetwork.vertexTransitWithoutOutflow singularity="
+            << trace.singularity.index()
+            << " sourceVertex=" << trace.sourceVertex.index()
+            << " trace=" << trace.id.index()
+            << " step=" << trace.segments.size() << " vertex=" << vertex.index()
+            << " mode="
+            << (arrivalMode == FieldVertexArrivalMode::EdgeTransit
+                    ? "EdgeTransit"
+                    : "FaceInterior")
+            << " arrival=" << face_text(arrivalFace)
+            << " arrivalBranch=" << static_cast<int>(arrivalBranch.value())
+            << " carrier=(" << carrier.first().index() << ','
+            << carrier.second().index() << ") owner="
+            << face_text(transit.nextFace)
+            << " ownerBranch=" << static_cast<int>(transit.nextBranch.value())
+            << direction_text(transit.nextFace, owner) << " onRadialRay="
+            << (audit.has_value() && audit->onRadialRay ? 1 : 0)
+            << " closedFan=" << (audit.has_value() && audit->closedFan ? 1 : 0)
+            << " sectors=" << (audit.has_value() ? audit->sectors.size() : 0U)
+            << '\n';
+  if (!audit.has_value()) return;
+  for (std::size_t index = 0U; index < audit->sectors.size(); ++index) {
+    const VertexStarSectorAudit &sector = audit->sectors[index];
+    std::clog << "FieldAlignedCurveNetwork.vertexTransitSector vertex="
+              << vertex.index() << " trace=" << trace.id.index()
+              << " step=" << trace.segments.size() << " index=" << index
+              << " face=" << face_text(sector.sourceFace)
+              << " branch=" << static_cast<int>(sector.branch.value())
+              << " next=" << sector.nextRadialVertex.index()
+              << " previous=" << sector.previousRadialVertex.index()
+              << " owner=" << (sector.containsContinuation ? 1 : 0)
+              << " inOwnSector="
+              << (sector.candidateRepresentativeInOwnSector ? 1 : 0)
+              << direction_text(sector.sourceFace,
+                                pairing_of(sector.sourceFace, sector.branch))
+              << '\n';
+  }
+}
