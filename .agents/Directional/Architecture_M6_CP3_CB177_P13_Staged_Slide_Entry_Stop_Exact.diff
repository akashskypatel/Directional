diff --git a/tests/FieldAlignedCurveNetworkTests.cpp b/tests/FieldAlignedCurveNetworkTests.cpp
index ce3a3e93512ddd2830e07d95565642ddb9b4c65e..deb9aa93839fc044ba9fa1d604284032ce75f537 100644
