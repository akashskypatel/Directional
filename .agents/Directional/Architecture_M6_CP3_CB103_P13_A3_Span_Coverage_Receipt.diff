+  std::size_t scheduledSpans = 0U;
+  std::size_t coveredSpans = 0U;
+  std::size_t partialSpans = 0U;
+  std::size_t unrecordedSpans = 0U;
+  /// Interval edges naming a span absent from the A3 schedule.
+  std::size_t foreignIntervalEdges = 0U;
