+// The chained factory stops a rim rail at every boundary field corner
+// (RA-224). The fixture's field corners are its feature corners, so the
+// derived corners change nothing; a corner declared on vertex 3, the middle of
+// the first square's left side, splits the chain through it.
+TEST(SurfaceCellAuthorityContractCutover,
+     ChainedInputStopsAtBoundaryFieldCorners) {
+  const auto fixture = build_rectangular_hard_rail_phase_front();
+  ASSERT_TRUE(fixture.topologyPlan.has_value());
+  ASSERT_TRUE(fixture.fieldNetwork.has_value());
+  ASSERT_TRUE(fixture.atlas.has_value());
+  const auto &topology = *fixture.topologyPlan;
+  Eigen::MatrixXd faceAxisX;
+  Eigen::MatrixXd faceAxisY;
+  directional::geometry::cross_field_axes(fixture.crossField, faceAxisX,
+                                          faceAxisY);
+  const auto fieldCorners =
+      directional::geometry::derive_boundary_field_corner_vertices(
+          fixture.mesh.V, fixture.mesh.F, faceAxisX, faceAxisY,
+          &*fixture.atlas);
+  const auto input =
+      [&](const std::vector<directional::authority::SourceVertexId> &corners) {
+        return directional::geometry::
+            make_chained_global_conformity_baseline_input(
+                fixture.mesh.V, fixture.targetSize, topology,
+                *fixture.fieldNetwork, fixture.featureCurves, corners);
+      };
+  const auto unstopped = input({});
+  const auto stopped = input(fieldCorners);
+  ASSERT_TRUE(unstopped.has_value());
+  ASSERT_TRUE(stopped.has_value());
+  ASSERT_EQ(4U, unstopped->chains.size());
+  EXPECT_TRUE(stopped->chains == unstopped->chains);
+
+  const auto split = input({directional::authority::SourceVertexId::from_index(
+                                3, static_cast<std::size_t>(fixture.mesh.V.rows()))
+                                .value()});
+  ASSERT_TRUE(split.has_value());
+  EXPECT_EQ(3U, split->chains.size());
+  EXPECT_EQ(unstopped->spans.size() + 1U, split->spans.size());
+  const auto built =
+      directional::geometry::build_global_conformity_baseline(topology, *split);
+  ASSERT_TRUE(built);
+  EXPECT_TRUE(directional::geometry::validate_global_conformity_baseline(
+      topology, *split, built.value()));
+  std::cout << "FIELD_CORNER_STOP_RECEIPT fieldCorners=" << fieldCorners.size()
+            << " chains=" << unstopped->chains.size() << '/'
+            << stopped->chains.size() << " splitChains=" << split->chains.size()
+            << " splitSpans=" << split->spans.size() << "\n";
+}
