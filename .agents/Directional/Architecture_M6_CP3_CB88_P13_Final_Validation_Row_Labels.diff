diff --git a/tests/SurfaceMeshOptimizerPhase22Tests.cpp b/tests/SurfaceMeshOptimizerPhase22Tests.cpp
--- a/tests/SurfaceMeshOptimizerPhase22Tests.cpp
+++ b/tests/SurfaceMeshOptimizerPhase22Tests.cpp
@@ -1912,3 +1912,43 @@ TEST(SurfaceMeshOptimizerPhase22,
