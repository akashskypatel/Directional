+// RA-220 (D5): the chained A3 input joins the source-boundary arcs of one rail
+// between stops and leaves hard-feature arcs alone. At target size 1 every unit
+// source edge is one interval under either input, so the chained baseline must
+// give the bounded-disk producer the subdivision the per-arc baseline gives it.
+TEST(SurfaceCellAuthorityContractCutover,
+     D5ChainedBaselineAtUnitSizeReproducesThePerArcGrid) {
+  auto fixture = build_rectangular_hard_rail_phase_front();
+  ASSERT_TRUE(fixture.topologyPlan.has_value());
+  ASSERT_TRUE(fixture.fieldNetwork.has_value());
+  const auto &topology = *fixture.topologyPlan;
+  const auto provenance = directional::pipeline::hard_rail_source_provenance_from_rails(
+      fixture.rails, static_cast<std::size_t>(fixture.mesh.V.rows()));
+  ASSERT_TRUE(provenance.has_value());
+  const Eigen::VectorXd unit =
+      Eigen::VectorXd::Constant(fixture.mesh.V.rows(), 1.0);
+  const auto perArcInput = directional::pipeline::remesh_pipeline_detail::
+      make_global_conformity_baseline_input(fixture.mesh.V, unit, topology);
+  const auto chainedInput =
+      directional::geometry::make_chained_global_conformity_baseline_input(
+          fixture.mesh.V, unit, topology, *fixture.fieldNetwork,
+          fixture.featureCurves);
+  ASSERT_TRUE(chainedInput.has_value());
+
+  // Chains exist, hold only source-boundary arcs, and replace their later arcs.
+  ASSERT_FALSE(chainedInput->chains.empty());
+  std::map<directional::geometry::ConformitySpanId, std::size_t> chainLength;
+  std::size_t chainedArcs = 0U;
+  for (const auto &chain : chainedInput->chains) {
+    ASSERT_GE(chain.size(), 2U);
+    chainLength[directional::geometry::ConformitySpanId::from_network_arc(
+        chain.front().arc)] = chain.size();
+    chainedArcs += chain.size() - 1U;
+    // The span's support is the accepted D5 chain support.
+    const auto *span = &*std::find_if(
+        chainedInput->spans.begin(), chainedInput->spans.end(),
+        [&](const auto &candidate) {
+          return candidate.id.network_arc() == chain.front().arc;
+        });
+    const auto support = directional::geometry::global_conformity_baseline_detail::
+        derive_mandatory_chain_support({chain}, topology.arcs());
+    ASSERT_TRUE(support.has_value());
+    EXPECT_TRUE(*support == span->supportPieces);
+    for (const auto &oriented : chain) {
+      const auto *arc = topology.find_arc(oriented.arc);
+      ASSERT_NE(nullptr, arc);
+      ASSERT_TRUE(arc->mandatoryEdge.has_value());
+      const auto &edges = fixture.fieldNetwork->mandatory_edges();
+      const auto edge = std::find_if(edges.begin(), edges.end(), [&](const auto &e) {
+        return e.id == *arc->mandatoryEdge;
+      });
+      ASSERT_NE(edges.end(), edge);
+      EXPECT_TRUE(edge->kind != directional::geometry::SurfaceCellRailKind::HardFeature);
+    }
+  }
+  EXPECT_EQ(topology.arcs().size(), chainedInput->spans.size() + chainedArcs);
+
+  const auto perArcBuilt =
+      directional::geometry::build_global_conformity_baseline(topology, perArcInput);
+  const auto chainedBuilt = directional::geometry::build_global_conformity_baseline(
+      topology, *chainedInput);
+  ASSERT_TRUE(perArcBuilt);
+  ASSERT_TRUE(chainedBuilt);
+  // Every arc is a unit source edge: one interval per edge, with no flip.
+  for (const auto &entry : perArcBuilt.value().schedule()) {
+    EXPECT_EQ("1", entry.count.to_string());
+  }
+  for (const auto &entry : chainedBuilt.value().schedule()) {
+    const auto chain = chainLength.find(entry.span);
+    EXPECT_EQ(std::to_string(chain == chainLength.end() ? 1U : chain->second),
+              entry.count.to_string());
+  }
+
+  const auto produce = [&](const directional::geometry::GlobalConformityBaselinePlan &baseline) {
+    fixture.conformityBaseline = baseline;
+    return build_fixed_plan_rectangular_hard_rail_network(
+        fixture, 1.0, &provenance->terminalContacts, nullptr,
+        &provenance->closedChains);
+  };
+  const auto perArc = produce(perArcBuilt.value());
+  const auto chained = produce(chainedBuilt.value());
+  ASSERT_EQ(directional::geometry::SurfaceCellProducerDisposition::Produced,
+            perArc.phaseFront.disposition())
+      << directional::geometry::surface_phase_front_failure_reason_name(
+             perArc.phaseFront.rejection_reason())
+      << hard_rail_first_failure_detail(perArc);
+  ASSERT_EQ(directional::geometry::SurfaceCellProducerDisposition::Produced,
+            chained.phaseFront.disposition())
+      << directional::geometry::surface_phase_front_failure_reason_name(
+             chained.phaseFront.rejection_reason())
+      << hard_rail_first_failure_detail(chained);
+  const auto &perArcProduct = perArc.phaseFront.product();
+  const auto &chainedProduct = chained.phaseFront.product();
+  EXPECT_EQ(perArcProduct.gridU(), chainedProduct.gridU());
+  EXPECT_EQ(perArcProduct.gridV(), chainedProduct.gridV());
+  ASSERT_EQ(perArcProduct.edges().size(), chainedProduct.edges().size());
+  ASSERT_EQ(perArcProduct.cells().size(), chainedProduct.cells().size());
+  for (std::size_t cell = 0U; cell < perArcProduct.cells().size(); ++cell) {
+    for (std::size_t corner = 0U; corner < 4U; ++corner) {
+      const auto &expected = perArcProduct.cells()[cell].corners[corner];
+      const auto &actual = chainedProduct.cells()[cell].corners[corner];
+      EXPECT_EQ(expected.face, actual.face) << cell << '/' << corner;
+      EXPECT_TRUE(expected.barycentric == actual.barycentric)
+          << cell << '/' << corner;
+    }
+  }
+
+  // The chained product tiles every span the per-arc product tiled.
+  const auto perArcSummary = directional::geometry::summarize_a3_span_coverage(
+      perArcProduct.edges(), perArcBuilt.value());
+  const auto chainedSummary = directional::geometry::summarize_a3_span_coverage(
+      chainedProduct.edges(), chainedBuilt.value());
+  EXPECT_EQ(0U, chainedSummary.partialSpans);
+  EXPECT_EQ(0U, chainedSummary.foreignIntervalEdges);
+  EXPECT_EQ(perArcSummary.unrecordedSpans, chainedSummary.unrecordedSpans);
+  EXPECT_EQ(perArcSummary.coveredSpans, chainedSummary.coveredSpans + chainedArcs);
+  for (const auto &coverage : chainedSummary.spans) {
+    if (chainLength.count(directional::geometry::ConformitySpanId::from_network_arc(
+            coverage.span)) != 0U) {
+      EXPECT_TRUE(coverage.covered) << coverage.span.index();
+    }
+  }
+  std::cout << "D5_CONSUMER_RECEIPT case=unit arcs=" << topology.arcs().size()
+            << " chains=" << chainedInput->chains.size()
+            << " chainedArcs=" << chainedArcs
+            << " cells=" << chainedProduct.cells().size()
+            << " coveredPerArc=" << perArcSummary.coveredSpans
+            << " coveredChained=" << chainedSummary.coveredSpans << "\n";
+}
+
+// RA-220 (D5): at the fixture's own target size a chained boundary side and
+// the per-arc hard rail facing it round separately. The baseline must still
+// build and validate; what the producer then does is reported, not asserted,
+// and decides whether the production switch can precede hard-rail chaining.
+TEST(SurfaceCellAuthorityContractCutover,
+     D5ChainedBaselineAtTheFixtureTargetBuildsAndReportsItsDisposition) {
+  auto fixture = build_rectangular_hard_rail_phase_front();
+  ASSERT_TRUE(fixture.topologyPlan.has_value());
+  ASSERT_TRUE(fixture.fieldNetwork.has_value());
+  const auto &topology = *fixture.topologyPlan;
+  const auto provenance = directional::pipeline::hard_rail_source_provenance_from_rails(
+      fixture.rails, static_cast<std::size_t>(fixture.mesh.V.rows()));
+  ASSERT_TRUE(provenance.has_value());
+  const auto input =
+      directional::geometry::make_chained_global_conformity_baseline_input(
+          fixture.mesh.V, fixture.targetSize, topology, *fixture.fieldNetwork,
+          fixture.featureCurves);
+  ASSERT_TRUE(input.has_value());
+  const auto built =
+      directional::geometry::build_global_conformity_baseline(topology, *input);
+  ASSERT_TRUE(built);
+  EXPECT_TRUE(directional::geometry::validate_global_conformity_baseline(
+      topology, *input, built.value()));
+  std::size_t chainedArcs = 0U;
+  for (const auto &chain : input->chains) chainedArcs += chain.size() - 1U;
+  EXPECT_EQ(topology.arcs().size(), built.value().schedule().size() + chainedArcs);
+
+  std::ostringstream counts;
+  for (const auto &chain : input->chains) {
+    const auto *head = built.value().find_schedule(
+        directional::geometry::ConformitySpanId::from_network_arc(chain.front().arc));
+    ASSERT_NE(nullptr, head);
+    counts << (counts.tellp() > 0 ? "," : "") << chain.size() << ':'
+           << head->count.to_string();
+  }
+  fixture.conformityBaseline = built.value();
+  const auto network = build_fixed_plan_rectangular_hard_rail_network(
+      fixture, 1.0, &provenance->terminalContacts, nullptr,
+      &provenance->closedChains);
+  const bool produced =
+      network.phaseFront.disposition() ==
+      directional::geometry::SurfaceCellProducerDisposition::Produced;
+  std::string covered = "none";
+  if (produced) {
+    const auto summary = directional::geometry::summarize_a3_span_coverage(
+        network.phaseFront.product().edges(), built.value());
+    EXPECT_EQ(0U, summary.partialSpans);
+    EXPECT_EQ(0U, summary.foreignIntervalEdges);
+    covered = std::to_string(summary.coveredSpans) + '/' +
+              std::to_string(summary.scheduledSpans);
+  }
+  std::cout << "D5_CONSUMER_RECEIPT case=fixtureTarget chains="
+            << input->chains.size() << " arcsToCount=" << counts.str()
+            << " disposition=" << (produced ? "Produced" : "Rejected")
+            << " reason="
+            << (produced ? "None"
+                         : directional::geometry::surface_phase_front_failure_reason_name(
+                               network.phaseFront.rejection_reason()))
+            << " covered=" << covered << "\n";
+}
