+  using Failure = embedded::EdgePieceRayFailure;
+  using Piece = authority::ExactSourceSupportPiece;
+  using Position = embedded::TraceCutPosition;
+  using Ray = embedded::EdgePieceRay;
+  using Rank = std::optional<std::size_t>;
