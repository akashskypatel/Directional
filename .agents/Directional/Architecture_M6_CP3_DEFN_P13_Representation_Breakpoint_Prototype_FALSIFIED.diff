+void mark_representation_only_nodes(SurfaceCellComplex &complex,
+                                    const Eigen::MatrixXd &vertices,
+                                    const Eigen::MatrixXi &faces) {
+  const int nodeCount = static_cast<int>(complex.nodes.size());
+  std::vector<std::vector<int>> outgoing(complex.nodes.size());
+  for (const SurfaceArrangementHalfedge &edge : complex.halfedges) {
+    if (edge.from >= 0 && edge.from < nodeCount) {
+      outgoing[static_cast<std::size_t>(edge.from)].push_back(edge.id);
+    }
+  }
+  const auto plain = [](const SurfaceArrangementHalfedge &edge) {
+    return !edge.hardFeature && !edge.railId.has_value() &&
+           edge.curveId < 0 && !edge.singularitySupport;
+  };
+  const auto halfedge = [&](const int id) -> const SurfaceArrangementHalfedge * {
+    return id >= 0 && id < static_cast<int>(complex.halfedges.size())
+               ? &complex.halfedges[static_cast<std::size_t>(id)]
+               : nullptr;
+  };
+  const auto position = [&](const int id) -> Eigen::RowVector3d {
+    const SurfaceArrangementNode &node = complex.nodes[static_cast<std::size_t>(id)];
+    Eigen::RowVector3d point = Eigen::RowVector3d::Zero();
+    for (int corner = 0; corner < 3; ++corner) {
+      point += node.barycentric(corner) * vertices.row(faces(node.sourceFace, corner));
+    }
+    return point;
+  };
+  // A cell with a reflex corner is not a rectangle of field lines. Patch turns
+  // are all convex, so such a cell keeps every boundary vertex until reflex
+  // corners have an owner.
+  std::vector<unsigned char> convexCell(complex.cells.size(), 1U);
+  for (std::size_t index = 0; index < complex.cells.size(); ++index) {
+    std::map<int, int> byFrom;
+    for (const int id : complex.cells[index].halfedges) {
+      if (const SurfaceArrangementHalfedge *edge = halfedge(id)) {
+        byFrom.emplace(edge->from, id);
+      }
+    }
+    std::vector<int> cycle;
+    for (int id = complex.cells[index].halfedges.empty()
+                      ? -1
+                      : complex.cells[index].halfedges.front();
+         id >= 0 && cycle.size() < complex.cells[index].halfedges.size();) {
+      cycle.push_back(id);
+      const auto next = byFrom.find(halfedge(id)->to);
+      id = next == byFrom.end() ? -1 : next->second;
+    }
+    if (cycle.size() != complex.cells[index].halfedges.size()) {
+      convexCell[index] = 0U;
+      continue;
+    }
+    for (std::size_t k = 0; k < cycle.size(); ++k) {
+      const SurfaceArrangementHalfedge *previous =
+          halfedge(cycle[(k + cycle.size() - 1U) % cycle.size()]);
+      const SurfaceArrangementHalfedge *current = halfedge(cycle[k]);
+      if (previous == nullptr || current == nullptr ||
+          previous->from < 0 || previous->from >= nodeCount ||
+          current->from < 0 || current->from >= nodeCount ||
+          current->to < 0 || current->to >= nodeCount) {
+        convexCell[index] = 0U;
+        break;
+      }
+      if (same_logical_side(*previous, *current, complex.nodes, vertices,
+                            faces)) {
+        continue;
+      }
+      const SurfaceArrangementNode &corner =
+          complex.nodes[static_cast<std::size_t>(current->from)];
+      if (corner.sourceFace < 0 || corner.sourceFace >= faces.rows()) {
+        convexCell[index] = 0U;
+        break;
+      }
+      const Eigen::Vector3d a = (position(current->from) - position(previous->from)).transpose();
+      const Eigen::Vector3d b = (position(current->to) - position(current->from)).transpose();
+      const Eigen::Vector3d p0 = vertices.row(faces(corner.sourceFace, 0)).transpose();
+      const Eigen::Vector3d p1 = vertices.row(faces(corner.sourceFace, 1)).transpose();
+      const Eigen::Vector3d p2 = vertices.row(faces(corner.sourceFace, 2)).transpose();
+      if (a.cross(b).dot((p1 - p0).cross(p2 - p0)) <= 0.0) {
+        convexCell[index] = 0U;
+        break;
+      }
+    }
+  }
+  const auto convex = [&](const int cell) {
+    return cell >= 0 && cell < static_cast<int>(convexCell.size()) &&
+           convexCell[static_cast<std::size_t>(cell)] != 0U;
+  };
+  for (int id = 0; id < nodeCount; ++id) {
+    SurfaceArrangementNode &node = complex.nodes[static_cast<std::size_t>(id)];
+    node.representationOnly = false;
+    const std::vector<int> &out = outgoing[static_cast<std::size_t>(id)];
+    if (node.id != id || node.hardBarrierCrossing || out.size() != 2U) {
+      continue;
+    }
+    const SurfaceArrangementHalfedge *first = halfedge(out[0]);
+    const SurfaceArrangementHalfedge *second = halfedge(out[1]);
+    if (first == nullptr || second == nullptr || first->to == second->to) {
+      continue;
+    }
+    const SurfaceArrangementHalfedge *intoFirstCell = halfedge(second->twin);
+    const SurfaceArrangementHalfedge *intoSecondCell = halfedge(first->twin);
+    if (intoFirstCell == nullptr || intoSecondCell == nullptr ||
+        intoFirstCell->cell != first->cell ||
+        intoSecondCell->cell != second->cell || !convex(first->cell) ||
+        !convex(second->cell) || !plain(*first) ||
+        !plain(*second) || !plain(*intoFirstCell) || !plain(*intoSecondCell)) {
+      continue;
+    }
+    node.representationOnly =
+        same_logical_side(*intoFirstCell, *first, complex.nodes, vertices,
+                          faces) &&
+        same_logical_side(*intoSecondCell, *second, complex.nodes, vertices,
+                          faces);
+  }
+}
+
 } // namespace directional::geometry::surface_arrangement_detail
 
