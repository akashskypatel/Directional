+// The terminal record of a trace that stops at `locus` before entering its
+// pending segment: the end of its last committed segment, which leaves that
+// segment's face through the locus edge. Empty when there is no such segment.
+std::optional<FieldAlignedTerminalContact> field_aligned_carrier_stop_contact(
+    const FieldAlignedCandidateTrace &trace,
+    const authority::FieldBoundaryPoint &locus,
+    const authority::TraceId struckTrace, const std::size_t struckSegment) {
+  if (trace.segments.empty() ||
+      trace.segments.back().outgoingCarrier != locus.edge ||
+      trace.segments.back().edgeTransitExit.has_value()) {
+    return std::nullopt;
+  }
+  const authority::SourceFaceTopologyKey &face =
+      trace.segments.back().sourceFace;
+  const auto barycentric = field_boundary_point_barycentric(face, locus);
+  if (!barycentric.has_value()) return std::nullopt;
+  FieldAlignedTerminalContact contact{face, *barycentric, struckTrace,
+                                      struckSegment};
+  contact.carrierLocus = locus;
+  return contact;
+}
