+  for (int seed = 0; seed < faceCount; ++seed) {
+    if (visited[static_cast<std::size_t>(seed)]) continue;
+    ProvisionalRegion region;
+    std::queue<int> queue;
+    queue.push(seed);
+    visited[static_cast<std::size_t>(seed)] = true;
