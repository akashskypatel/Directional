+    region.boundaryEdgeTopology.erase(
+        std::unique(region.boundaryEdgeTopology.begin(),
+                    region.boundaryEdgeTopology.end()),
+        region.boundaryEdgeTopology.end());
+    std::sort(region.internalIsolationSeamTopology.begin(),
+              region.internalIsolationSeamTopology.end());
