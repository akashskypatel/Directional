  test "$(grep -c '^m3Cp4c2Y1;witness=torus;' "$RESULT/d1-records.txt" || true)" -eq 1 || d1_structural=false
  test "$(grep -c '^m3Cp4c2Y1;witness=prescribed-sphere;' "$RESULT/d1-records.txt" || true)" -eq 1 || d1_structural=false
  test "$(grep -c '^m3Cp4c2Y1;witness=two-ring;' "$RESULT/d1-records.txt" || true)" -eq 1 || d1_structural=false
  test "$(wc -l < "$RESULT/d1-records.txt")" -eq 3 || d1_structural=false
  test "$(grep -c '^m3Cp4c2PublicationCounts;torus=1;prescribed-sphere=1;two-ring=1;total=3$' "$RESULT/d1-publication-counts.txt" || true)" -eq 1 || d1_structural=false
  sphere_line="$(grep '^m3Cp4c2Y1;witness=prescribed-sphere;' "$RESULT/d1-records.txt" || true)"
  if [[ "$sphere_line" != *';pipelineAtlasAvailable=true;'* || "$sphere_line" != *';pipelineNetworkAvailable=true;'* || "$sphere_line" != *';oracleSelfConsistent='* ]]; then d1_structural=false; fi
  torus_line="$(grep '^m3Cp4c2Y1;witness=torus;' "$RESULT/d1-records.txt" || true)"
  two_ring_line="$(grep '^m3Cp4c2Y1;witness=two-ring;' "$RESULT/d1-records.txt" || true)"
  [[ "$torus_line" == *';oracleSelfConsistent='* ]] || d1_structural=false
  [[ "$two_ring_line" == *';oracleSelfConsistent='* ]] || d1_structural=false
  echo "d1StructurallyAdmissible=${d1_structural}" > "$RESULT/d1-decision.txt"
  if [[ "$torus_line" == *';pipelinePlanAvailable=true;'* ]]; then
    echo 'premiseDischargingFinding=torus-global-topology-plan-derived' >> "$RESULT/d1-decision.txt"
  else
    echo 'premiseDischargingFinding=torus-global-topology-plan-not-observed' >> "$RESULT/d1-decision.txt"
  fi
  if [[ "$d1_structural" != true ]]; then
    semantic_stop="D1_STRUCTURALLY_INADMISSIBLE"
  fi
fi

if [[ -z "$semantic_stop" ]]; then
  # R5-4: D2 exactly once after structurally admissible D1.
  echo '=== R5-4 D2 exactly once ==='
  d2_identity='GlobalTopologyPlan.Cp4c2CutGraphFailureLocalizationIsObservable'
  set +e
  run_identity 357 "$d2_identity" directional_surface_cell_producer_tests d2
  d2_exit=$?
  set -e
  if [[ "$d2_exit" -eq 2 ]]; then exit 2; fi
  echo "d2Exit=${d2_exit}" > "$RESULT/d2-exit.txt"
  d2_log="$(find "$RAW" -maxdepth 1 -type f -name 'd2-357-*' -print -quit)"
  grep 'm3Cp4c2Y2' "$d2_log" > "$RESULT/d2-records.txt" || true
  echo "d2RecordCount=$(wc -l < "$RESULT/d2-records.txt")" > "$RESULT/d2-decision.txt"
fi

# R5-5: immutable postflight regardless of semantic stop.
echo '=== R5-5 immutable postflight ==='
inventory_tree "$PACKAGE" "$RESULT/package-post.tsv"
inventory_tree "$SOURCE" "$RESULT/source-post.tsv"
cmp "$RESULT/package-pre.tsv" "$RESULT/package-post.tsv"
cmp "$RESULT/source-pre.tsv" "$RESULT/source-post.tsv"
{
  echo 'packageInventoryMatch=true'
  echo 'sourceInventoryMatch=true'
  echo 'configureOccurred=false'
  echo 'compileOccurred=false'
  echo 'relinkOccurred=false'
  echo 'repairOccurred=false'
  echo 'generatedDiscoveryOccurred=false'
  echo 'mutationOccurred=false'
  echo 'benchmarkExecution=false'
  echo 'selected_r2_branch=NONE'
  echo 'selected_gate=NONE'
  echo 'gate_execution_authorized=false'
} > "$RESULT/postflight.txt"

if [[ -n "$semantic_stop" ]]; then
  printf '%s\n' "$semantic_stop" > "$RESULT/status.txt"
else
  printf 'R5_EXEC_COMPLETE\n' > "$RESULT/status.txt"
fi

python3 - "$RESULT" "$SOURCE_SHA" "$PACKAGE_ARTIFACT_ID" "$PACKAGE_SHA256" <<'PY'
from pathlib import Path
import json, sys
r=Path(sys.argv[1])
def text(name, default=''):
    p=r/name
    return p.read_text(errors='replace').strip() if p.exists() else default
summary={
 'turn':'M3-CP4c-2-TB-X2-R5-EXEC',
 'status':text('status.txt'),
 'semanticSource':sys.argv[2],
 'packageArtifactId':int(sys.argv[3]),
 'packageSha256':sys.argv[4],
 'acceptedPrefixes':text('accepted-prefix-results.txt').splitlines(),
 'aa2':text('aa2.txt').splitlines(),
 'd1Decision':text('d1-decision.txt').splitlines(),
 'd1Exit':text('d1-exit.txt'),
 'd2Decision':text('d2-decision.txt').splitlines(),
 'd2Exit':text('d2-exit.txt'),
 'postflight':text('postflight.txt').splitlines(),
 'runtimeExecution':True,
 'benchmarkExecution':False,
 'selected_r2_branch':'NONE',
 'selected_gate':'NONE',
 'gate_execution_authorized':False,
}
(r/'summary.json').write_text(json.dumps(summary,indent=2)+"\n")
PY
cat "$RESULT/status.txt"
cat "$RESULT/summary.json"
