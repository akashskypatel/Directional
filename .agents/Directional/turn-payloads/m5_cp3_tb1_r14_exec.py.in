#!/usr/bin/env python3
import collections, csv, datetime as dt, hashlib, json, os, pathlib, re, shlex, shutil, stat, subprocess, sys, tarfile

TURN='M5-CP3-TB1-R14-EXEC'
CANDIDATE=10733058003
COMPILE_LOG=10732709067
ROUTING=10592987234
SOURCE_SHA='6bad9eb5626e77a234ffb2c14f621195105e4ba1'
CANDIDATE_SHA='@@SHA256:candidate@@'
COMPILE_LOG_SHA='@@SHA256:compile_log@@'
ROOT_MANIFEST_SHA='@@SHA256:root_manifest@@'
SOURCE_ARCHIVE_SHA='@@SHA256:source_archive@@'
ROUTING_SHA='@@SHA256:routing@@'
IDENTITY_MAP_SHA='@@SHA256:identity_map@@'
SELECTOR_REL='.agents/Directional/Architecture_M4_CP4_CB8_Required_Green_Selector_430.txt'
SELECTOR_SHA='@@SHA256:selector@@'
PREFIX427_SHA='@@SHA256:prefix427@@'
MECHANISM=[
'M5CP3.PeriodicRelationEndpointBranchUsesAcceptedOccurrenceAuthority',
'M5CP3.StorageCanonicalPeriodicRelationResolvesSemanticForwardReverse',
'SurfaceCellsPhase10.PeriodicHolonomyReverseDescriptionCanonicalizesWithoutDuplicateGenerator',
'SurfaceCellsPhase10.PeriodicHolonomySameRegionTopologyDistinctRelationsAreRetained',
'M5CP1.ComponentAggregationPreservesCanonicalPeriodicRelationIdWithoutOffsetRemap',
'M5CP1.SelectedRelationPathCertificateSurvivesRelationContainerPermutation',
'M5CP1.UnusedValidPeriodicRelationDoesNotChangeSelectedCertificate',
'M5CP1.AlteredSelectedRelationTransformFailsCertificateValidation',
'SurfacePhaseFrontProductFactoryAuthority.ConflictingPeriodicRelationValueRejectsAtCheckedFactory',
'SurfacePhaseFrontProductFactoryAuthority.NonReciprocalPeriodicRelationRejectsAtCheckedFactory',
'SurfacePhaseFrontProductFactoryAuthority.RepresentationRenumberedPeriodicRelationRejectsAtCheckedFactory']
FOCUSED=[
'FieldTransportAtlas.RetainsDirectedTransitionValueForHardFeatureWithoutTraversalAdjacency']
PRODUCED=[
'M5CP3.ProducedTorusPublishesTwoCanonicalPeriodicRelationsAndOwnedEdges',
'M5CP3.ProducedTorusPeriodicRelationStoragePermutationPreservesSelectedCertificate',
'M5CP3.ProducedTorusMissingPeriodicRelationOwnerRejectsTyped',
'M5CP3.ProducedTorusNonzeroZ4RotationTranslationMaterializes',
'M5CP3.ProducedTorusTamperedNonzeroZ4TransformRejectsTyped',
'M5CP3.ProducedTorusUnusedValidRelationDoesNotAlterSelectedCertificate']
BINARIES=['directional_surface_cell_authority_kernel_tests','directional_surface_cell_producer_tests','directional_surface_cell_completion_tests','directional_surface_cell_validation_tests']
EXPECTED_CENSUS={BINARIES[0]:31,BINARIES[1]:283,BINARIES[2]:75,BINARIES[3]:41}

class OrchestrationFailure(RuntimeError): pass

def fail(msg): raise OrchestrationFailure(msg)
def utc(): return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat().replace('+00:00','Z')
def sha(path):
    h=hashlib.sha256()
    with open(path,'rb') as f:
        for chunk in iter(lambda:f.read(1024*1024),b''): h.update(chunk)
    return h.hexdigest()
def write(path,text): pathlib.Path(path).write_text(text,encoding='utf-8')
def run(cmd, **kw): return subprocess.run(cmd, check=True, **kw)

def download_artifact(repo, token, artifact_id, expected, dest, receipt):
    headers=['-H',f'Authorization: Bearer {token}','-H','Accept: application/vnd.github+json','-H','X-GitHub-Api-Version: 2022-11-28']
    meta_raw=subprocess.check_output(['curl','--fail','--silent','--show-error',*headers,f'https://api.github.com/repos/{repo}/actions/artifacts/{artifact_id}'])
    meta=json.loads(meta_raw)
    provider=meta.get('digest','')
    if provider != f'sha256:{expected}': fail(f'artifact {artifact_id} provider digest {provider}')
    subprocess.run(['curl','-L','--fail','--silent','--show-error',*headers,f'https://api.github.com/repos/{repo}/actions/artifacts/{artifact_id}/zip','-o',str(dest)],check=True)
    actual=sha(dest)
    if actual != expected: fail(f'artifact {artifact_id} downloaded digest {actual}')
    write(receipt,f'artifact_id={artifact_id}\\nprovider_digest={provider}\\ndownloaded_zip_sha256={actual}\\n')
def census(root,out):
    root=pathlib.Path(root).resolve(); rows=[]
    paths=[root,*sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())]
    for p in paths:
        st=p.lstat(); rel='.' if p==root else p.relative_to(root).as_posix(); mode=format(stat.S_IMODE(st.st_mode),'o')
        if stat.S_ISREG(st.st_mode): kind='file'; digest=sha(p); target='-'
        elif stat.S_ISDIR(st.st_mode): kind='directory'; digest='-'; target='-'
        elif stat.S_ISLNK(st.st_mode): kind='symlink'; digest='-'; target=os.readlink(p)
        else: kind='other'; digest='-'; target='-'
        rows.append(f'{rel}\t{kind}\t{mode}\t{st.st_size}\t{digest}\t{target}\n')
    write(out,''.join(rows))

def owner_map(source, identities):
    source=pathlib.Path(source); cmake=(source/'cmake/DirectionalTests.cmake').read_text(errors='replace')
    def cpp(text): return [x.strip() for x in text.splitlines() if x.strip().endswith('.cpp')]
    producer=re.search(r'set\(DIRECTIONAL_SURFACE_CELL_PRODUCER_TEST_SOURCES(.*?)\)\n\nadd_executable',cmake,re.S)
    if not producer: fail('producer source set not found')
    targets={BINARIES[1]:cpp(producer.group(1))}
    for target in (BINARIES[0],BINARIES[2],BINARIES[3]):
        m=re.search(r'add_executable\(\s*'+re.escape(target)+r'(.*?)\)\s*\n',cmake,re.S)
        if not m: fail(f'target source block not found: {target}')
        targets[target]=cpp(m.group(1))
    pat=re.compile(r'\bTEST(?:_F|_P)?\s*\(\s*([A-Za-z0-9_]+)\s*,\s*([A-Za-z0-9_]+)\s*\)')
    owners={}
    for target,rels in targets.items():
        for rel in rels:
            p=source/rel
            if not p.is_file(): fail(f'owner source absent: {target}:{rel}')
            for suite,name in pat.findall(p.read_text(errors='replace')): owners.setdefault(f'{suite}.{name}',[]).append((target,rel))
    rows=[]
    for n,identity in enumerate(identities,1):
        found=owners.get(identity,[])
        if len(found)!=1: fail(f'focused identity owner count {len(found)} for {identity}')
        rows.append((n,identity,*found[0]))
    return rows

def manifest_check(pkg,out):
    manifest=pathlib.Path(pkg)/'SHA256SUMS'
    if not manifest.is_file() or sha(manifest)!=ROOT_MANIFEST_SHA: fail('candidate root manifest identity mismatch')
    lines=[x for x in manifest.read_text().splitlines() if x.strip()]
    if len(lines)!=28: fail(f'candidate root manifest row count {len(lines)}')
    p=subprocess.run(['sha256sum','-c','SHA256SUMS'],cwd=pkg,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
    write(out,p.stdout)
    if p.returncode or sum(x.endswith(': OK') for x in p.stdout.splitlines())!=28: fail('candidate root manifest did not verify 28/28')

def self_manifest(result):
    result=pathlib.Path(result); target=result/'SHA256SUMS'
    rows=[]
    for p in sorted(result.rglob('*')):
        if p.is_file() and p!=target: rows.append(f'{sha(p)}  {p.relative_to(result).as_posix()}\n')
    write(target,''.join(rows))

def main():
    repo=os.environ['GITHUB_REPOSITORY']; token=os.environ['GH_TOKEN']; root=pathlib.Path(os.environ['RUNNER_TEMP'])/TURN
    pkg=root/'package'; routing=root/'routing'; source=root/'source'; execv=root/'execution-view'; runtime=root/'runtime'; result=pathlib.Path(os.environ['RUNNER_TEMP'])/(TURN+'-result')
    for p in (pkg,routing,source,execv/'bin',runtime,result/'raw'/'mechanism',result/'raw'/'focused',result/'raw'/'produced',result/'raw'/'selector',result/'resources'/'mechanism',result/'resources'/'focused',result/'resources'/'produced',result/'resources'/'selector'): p.mkdir(parents=True,exist_ok=True)
    state={'preflight_completed':False,'runtime_started':False,'runtime_completed':False,'orchestration_failure':False,'benchmark_execution':0,'configure_execution':0,'compile_execution':0,'relink_execution':0,'generated_discovery':0,'package_repair':0,'mode_repair':0,'source_test_fixture_selector_mutation':0}
    candidate_zip=root/f'candidate-{CANDIDATE}.zip'; compile_log_zip=root/f'compile-log-{COMPILE_LOG}.zip'; routing_zip=root/f'routing-{ROUTING}.zip'
    pre={}; selector=None; identity_map=None
    try:
        write(result/'environment.txt',f'turn={TURN}\nrun_id={os.environ.get("GITHUB_RUN_ID","")}\nevent_sha={os.environ.get("GITHUB_SHA","")}\nrepository={repo}\nrunner_os={os.environ.get("RUNNER_OS","")}\nstarted_at={utc()}\n')
        download_artifact(repo,token,CANDIDATE,CANDIDATE_SHA,candidate_zip,result/'candidate-artifact-authority.txt')
        compile_receipt=root/'compile-log-artifact-authority.tmp'
        download_artifact(repo,token,COMPILE_LOG,COMPILE_LOG_SHA,compile_log_zip,compile_receipt)
        with (result/'candidate-artifact-authority.txt').open('a',encoding='utf-8') as f:
            f.write('compile_log_')
            f.write(compile_receipt.read_text(encoding='utf-8').replace('\n','\ncompile_log_').rstrip('compile_log_') + '\n')
        download_artifact(repo,token,ROUTING,ROUTING_SHA,routing_zip,result/'routing-artifact-authority.txt')
        run(['unzip','-q',str(candidate_zip),'-d',str(pkg)]); run(['unzip','-q',str(routing_zip),'-d',str(routing)])
        manifest_check(pkg,result/'candidate-manifest-check.txt')
        if (pkg/'metadata/source-commit.txt').read_text().strip()!=SOURCE_SHA: fail('candidate source commit mismatch')
        for name in ('build-exit-code.txt','preflight-exit-code.txt'):
            if (pkg/'metadata'/name).read_text().strip()!='0': fail(f'candidate {name} nonzero')
        for p in (pkg/'metadata').glob('source-status-*.txt'):
            if p.stat().st_size: fail(f'candidate source status dirty: {p.name}')
        boundary=(pkg/'metadata/command-boundary.txt').read_text()
        for token1 in ('runtimeExecution=false','turnBoundary=Code+Build-only','exactArithmeticBackend=GMP','preflightCompile=true'):
            if token1 not in boundary.splitlines(): fail(f'missing command-boundary token {token1}')
        gmp=(pkg/'metadata/gmp-evidence.txt').read_text(errors='replace'); cache=(pkg/'metadata/CMakeCache.txt').read_text(errors='replace')
        if 'DIRECTIONAL_ENABLE_GMP:BOOL=ON' not in cache or 'gmpxx' not in gmp or not re.search(r'gmpxx.*gmp|gmp.*gmpxx',gmp): fail('GMP/GMPXX link evidence missing')
        for binary in BINARIES:
            p=pkg/'bin'/binary
            if not p.is_file() or not (p.stat().st_mode & 0o111): fail(f'owner executable absent/non-executable: {binary}')
        archives=list((pkg/'source').glob('source-*.tar.gz')); expected=pkg/'source'/f'source-{SOURCE_SHA}.tar.gz'
        if archives!=[expected] or sha(expected)!=SOURCE_ARCHIVE_SHA: fail('packaged source archive identity mismatch')
        run(['tar','-xzf',str(expected),'-C',str(source)])
        selector=source/SELECTOR_REL; data=selector.read_bytes(); lines=data.splitlines(keepends=True)
        if b'\r' in data or len(lines)!=430 or any(not x.endswith(b'\n') for x in lines): fail('selector430 LF/row-count mismatch')
        if hashlib.sha256(data).hexdigest()!=SELECTOR_SHA or hashlib.sha256(b''.join(lines[:427])).hexdigest()!=PREFIX427_SHA: fail('selector430/prefix digest mismatch')
        identity_map=routing/'identity-map.tsv'
        if not identity_map.is_file() or sha(identity_map)!=IDENTITY_MAP_SHA: fail('routing identity-map digest mismatch')
        rows=list(csv.DictReader(identity_map.open(),delimiter='\t'))
        if len(rows)!=430 or [int(r['ordinal']) for r in rows]!=list(range(1,431)) or len({r['identity'] for r in rows})!=430: fail('routing identity-map shape mismatch')
        counts=collections.Counter(r['binary'] for r in rows)
        if counts!=EXPECTED_CENSUS: fail(f'routing owner census mismatch: {dict(counts)}')
        selector_ids=[x.decode().strip() for x in lines]
        if selector_ids!=[r['identity'] for r in rows]: fail('routing identities differ from selector430 order')
        focused=owner_map(source,MECHANISM+FOCUSED+PRODUCED)
        write(result/'focused-routing.tsv','ordinal\tidentity\tbinary\tsource\n'+''.join(f'{o}\t{i}\t{b}\t{s}\n' for o,i,b,s in focused))
        census(pkg,result/'package-census-before.tsv'); census(source,result/'source-census-before.tsv')
        run(['cp','-a',str(pkg/'bin')+'/.',str(execv/'bin')]); (execv/'test-data'/'benchmarks').mkdir(parents=True,exist_ok=True)
        run(['cp','-a',str(source/'benchmarks'/'fixtures'),str(execv/'test-data'/'benchmarks')])
        for binary in BINARIES:
            a=pkg/'bin'/binary; b=execv/'bin'/binary
            if sha(a)!=sha(b) or stat.S_IMODE(a.stat().st_mode)!=stat.S_IMODE(b.stat().st_mode): fail(f'execution-view binary mismatch: {binary}')
        census(execv,result/'execution-view-before.tsv')
        pre={'package':(result/'package-census-before.tsv').read_bytes(),'source':(result/'source-census-before.tsv').read_bytes(),'exec':(result/'execution-view-before.tsv').read_bytes()}
        state['preflight_completed']=True

        maps={identity:(binary,src) for _,identity,binary,src in focused}; route={r['identity']:r['binary'] for r in rows}
        exe_sha={b:sha(execv/'bin'/b) for b in BINARIES}
        def execute_phase(name, ids, route_map):
            ledger=result/f'{name}-ledger.tsv'; header='ordinal\tidentity\tbinary\tcommand\tstart\tend\texit\tselected\tskipped\tpassed\tresult\texe_sha256\traw_sha256\n'; write(ledger,header)
            with ledger.open('a',encoding='utf-8') as lf:
                for ordinal,identity in enumerate(ids,1):
                    binary=route_map(identity); exe=execv/'bin'/binary; raw=result/'raw'/name/f'ordinal-{ordinal:03d}.log'; resource=result/'resources'/name/f'ordinal-{ordinal:03d}.time.txt'; work=runtime/name/f'ordinal-{ordinal:03d}'; work.mkdir(parents=True,exist_ok=True)
                    cmd=['/usr/bin/time','-v','-o',str(resource),'env','GTEST_FAIL_IF_NO_TEST_SELECTED=1','GTEST_COLOR=no',str(exe),f'--gtest_filter={identity}']
                    start=utc()
                    with raw.open('wb') as f: p=subprocess.run(cmd,cwd=work,stdout=f,stderr=subprocess.STDOUT)
                    end=utc(); text1=raw.read_text(errors='replace'); selected=len(re.findall(r'^\[ RUN      \] ',text1,re.M)); skipped=len(re.findall(r'^\[  SKIPPED \] ',text1,re.M)); passed=len(re.findall(r'^\[       OK \] ',text1,re.M))
                    print(f'{TURN} phase={name} ordinal={ordinal} identity={identity} owner={binary}', flush=True)
                    print(text1,end='' if text1.endswith('\n') else '\n',flush=True)
                    integrity=(selected==1 and skipped==0)
                    outcome='PASS' if integrity and p.returncode==0 and passed==1 else ('RED' if integrity else 'INVALID')
                    lf.write(f'{ordinal}\t{identity}\t{binary}\t{shlex.join(cmd)}\t{start}\t{end}\t{p.returncode}\t{selected}\t{skipped}\t{passed}\t{outcome}\t{exe_sha[binary]}\t{sha(raw)}\n'); lf.flush()
                    if not integrity: fail(f'exact-one/zero-skip failed {identity}: selected={selected} skipped={skipped}')
            return ledger
        state['runtime_started']=True
        m=execute_phase('mechanism',MECHANISM,lambda i:maps[i][0]); f=execute_phase('focused',FOCUSED,lambda i:maps[i][0]); p=execute_phase('produced',PRODUCED,lambda i:maps[i][0]); s=execute_phase('selector',selector_ids,lambda i:route[i]); state['runtime_completed']=True
        def summarize(path):
            rr=list(csv.DictReader(path.open(),delimiter='\t')); red=[int(x['ordinal']) for x in rr if x['result']!='PASS']; return len(rr),len(rr)-len(red),red
        mt,mp,mr=summarize(m); ft,fp,fr=summarize(f); pt,pp,pr=summarize(p); st,sp,sr=summarize(s)
        write(result/'semantic-summary.txt',f'mechanism_total={mt}\nmechanism_pass={mp}\nmechanism_red_ordinals={mr}\nfocused_total={ft}\nfocused_pass={fp}\nfocused_red_ordinals={fr}\nproduced_total={pt}\nproduced_pass={pp}\nproduced_red_ordinals={pr}\nselector_total={st}\nselector_pass={sp}\nselector_red_ordinals={sr}\nplanned_processes={mt+ft+pt+st}\nbenchmark_execution=0\n')

        census(pkg,result/'package-census-after.tsv'); census(source,result/'source-census-after.tsv'); census(execv,result/'execution-view-after.tsv')
        if pre['package']!=(result/'package-census-after.tsv').read_bytes(): fail('package byte/mode census changed')
        if pre['source']!=(result/'source-census-after.tsv').read_bytes(): state['source_test_fixture_selector_mutation']=1; fail('source byte/mode census changed')
        if pre['exec']!=(result/'execution-view-after.tsv').read_bytes(): fail('execution-view byte/mode census changed')
        manifest_check(pkg,result/'candidate-manifest-check-after.txt')
        data2=selector.read_bytes()
        if hashlib.sha256(data2).hexdigest()!=SELECTOR_SHA or hashlib.sha256(b''.join(data2.splitlines(keepends=True)[:427])).hexdigest()!=PREFIX427_SHA: fail('selector postflight digest mismatch')
        if sha(identity_map)!=IDENTITY_MAP_SHA: fail('routing identity map changed')
        if any(state[k] for k in ('benchmark_execution','configure_execution','compile_execution','relink_execution','generated_discovery','package_repair','mode_repair','source_test_fixture_selector_mutation')): fail('prohibited-operation counter nonzero')
        write(result/'immutability.txt','package_census_equal=true\nsource_census_equal=true\nexecution_view_census_equal=true\nmanifest_after=28/28\nselector_unchanged=true\nrouting_map_unchanged=true\n')
        return 0
    except Exception as e:
        state['orchestration_failure']=True
        write(result/'orchestration-failure.txt',f'{type(e).__name__}: {e}\n')
        return 90
    finally:
        write(result/'execution-boundary.txt',''.join(f'{k}={str(v).lower() if isinstance(v,bool) else v}\n' for k,v in state.items())+f'finished_at={utc()}\n')
        self_manifest(result)

if __name__=='__main__': sys.exit(main())
