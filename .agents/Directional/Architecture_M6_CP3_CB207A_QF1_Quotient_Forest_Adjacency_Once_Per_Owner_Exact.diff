+// Sorted traversal records of a selected forest, keyed by occurrence. Each
+// forest edge contributes one forward and one reverse record. Every field takes
+// part in the order, so equivalent records are identical and incremental
+// insertion yields the same lists as appending all records and sorting.
+using QuotientForestAdjacency =
+    std::map<authority::OccurrenceId, std::vector<QuotientForestTraversalEdge>>;
+
+void add_quotient_forest_edge(QuotientForestAdjacency &adjacency,
+                              const QuotientForestEdge &edge) {
+  const auto insert = [&adjacency](const authority::OccurrenceId from,
+                                   QuotientForestTraversalEdge traversal) {
+    auto &edges = adjacency[from];
+    const auto position = std::upper_bound(
+        edges.begin(), edges.end(), traversal,
+        [](const auto &a, const auto &b) {
+          return std::tie(a.next, a.relation, a.orientation) <
+                 std::tie(b.next, b.relation, b.orientation);
+        });
+    edges.insert(position, std::move(traversal));
+  };
+  insert(edge.first, {edge.second, edge.relation, authority::Orientation::Forward});
+  insert(edge.second, {edge.first, edge.relation, authority::Orientation::Reverse});
+}
+
+QuotientForestAdjacency
